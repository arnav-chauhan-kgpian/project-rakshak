# Qdrant Configuration
# ====================
# Supports both local Docker and Qdrant Cloud

# Option 1: Qdrant Cloud (recommended for production)
# Get your URL and API key from https://cloud.qdrant.io
# QDRANT_URL=https://your-cluster.region.cloud.qdrant.io
# QDRANT_API_KEY=your-api-key-here

# Option 2: Local Qdrant Docker (default)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Gemini LLM Configuration
# ========================
# Get your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
